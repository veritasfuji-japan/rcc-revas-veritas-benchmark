  "v0_2_changes_from_v0_1": [
    "Separates upstream RCC/REVAS decision identity/hash from VERITAS request_id, decision_id, decision_hash, and execution_intent_id.",
    "Makes source-namespace preservation normative for revas_decision, admissibility_status, Pilot 02 action labels, and replay adoption labels.",
    "Adds owner/default/missing-field behavior for every benchmark-relevant field.",
    "Defines a proposed rcc_revas_to_veritas_handoff v0.2 envelope and deterministic adapter rules.",
    "Adds public Pilot 02 v0.2 action ontology as study context without treating it as VERITAS authority semantics.",
    "Adds explicit prohibition on mapping RCC/REVAS decision_lock.decision_sha256 into VERITAS ExecutionIntent.decision_hash.",
    "Adds strong separation of RCC/REVAS verification from VerifiedAuthorityEvidence / VerifiedHumanApprovalReceipt.",
    "Aligns promotion requirements with current VERITAS ExecutionIntent, ActionClassContract, AuthorityEvidence, HumanApprovalReceipt, and BindReceipt contracts."
  ],
