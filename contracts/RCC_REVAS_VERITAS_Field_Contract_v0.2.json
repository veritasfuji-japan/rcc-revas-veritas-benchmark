      "derive correlation_id deterministically",
      "preserve limitations, measurement boundaries, blocked_use, and claim boundaries",      "pass through typed action fields only when they were independently supplied as typed fields"
    ],
    "prohibited": [
      "infer actor_identity from source_model_alias, API caller, or prose",
      "infer typed intended_action from revas_action, rationale, required_next_step, final_answer, or allowed_use",
      "translate RCC/REVAS ALLOW/admissible/candidate_adopted/CONTINUE directly into VERITAS proceed or execution permission",
      "translate RCC/REVAS verifier pass into Authority Evidence or Human Approval",
      "translate NeoMundi measurement_status=complete into governance evidence_complete",
      "reuse RCC/REVAS decision_lock.decision_sha256 as VERITAS decision_hash",
      "reuse source_trace_id as VERITAS request_id or decision_id",
      "fill missing security-relevant fields with defaults or plausible values",
      "drop null coverage, limitations, blocked-use constraints, or public claim boundaries",
      "permit external effect from the adapter itself"
    ]
